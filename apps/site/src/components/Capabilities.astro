---
import { AGENT_COUNT } from "../lib/agents";

interface Capability {
  title: string;
  body: string;
  /** A real command or path, when one says it faster than a sentence. */
  example?: string;
}

const capabilities: Capability[] = [
  {
    title: "Get skills from anywhere",
    body: "Install from the skills.sh marketplace, a Git repository (a GitHub link to a folder works), a .zip or .skill file, or a folder on disk. Skills already sitting in your agents' folders can be imported in one go.",
  },
  {
    title: "Turn a skill on per agent",
    body: `Switch a skill on for any of ${AGENT_COUNT} agents and Loadout links it into that agent's skills folder, or copies it if you prefer. Presets switch a whole set on or off at once, from the app or the menu bar.`,
    example: "~/.codex/skills/code-review → ~/.loadout/skills/code-review",
  },
  {
    title: "Keep projects in step",
    body: "Add a repository and manage the skills it carries for each agent. Loadout shows which copies drifted from your library and lets you push or pull the change. When copies disagree, you pick which version wins.",
  },
  {
    title: "Edit skills in place",
    body: "A Markdown editor with a live preview checks each SKILL.md against the Agent Skills format as you type and takes you to the line that needs fixing. Unsaved text survives quitting, and the last 20 versions of every file are kept.",
  },
  {
    title: "Update without surprises",
    body: "Check skills against where they came from, on demand or on a schedule. Before an update changes anything it lists the files it would delete and the edits you made, and waits for you.",
  },
  {
    title: "Back up and sync",
    body: "Your library is a Git repository. Push it to GitHub, restore it on another computer, and keep machines in step. Changes to the same skill on two computers are merged skill by skill, and you choose when they clash.",
  },
  {
    title: "Let your agents do it",
    body: "A loadout command-line tool and a bundled skill let an agent install, switch on and update skills itself, with the same safety rules as the app.",
    example: "loadout skills install owner/repo --all",
  },
];
---

<section class="wrap section" id="what-it-does" aria-labelledby="what-title">
  <h2 id="what-title">What it does</h2>
  <dl>
    {
      capabilities.map((item) => (
        <div class="item">
          <dt>
            <h3>{item.title}</h3>
          </dt>
          <dd>
            <p>{item.body}</p>
            {item.example ? <code class="example">{item.example}</code> : null}
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  dl {
    display: grid;
    gap: clamp(2rem, 4vw, 2.75rem);
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
  }

  .item {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: 0.5rem clamp(1.5rem, 5vw, 4rem);
  }

  dt h3 {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-stretch: 78%;
    font-weight: 740;
  }

  dd {
    margin: 0;
    color: var(--slate);
  }

  .example {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: color-mix(in srgb, var(--mint-ink) 10%, transparent);
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  @media (max-width: 44rem) {
    .item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
