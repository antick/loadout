---
import { DEMO_PATH } from "../lib/site";
---

<section class="band" id="demo" aria-labelledby="demo-title">
  <div class="wrap section">
    <div class="intro">
      <h2 id="demo-title">Try the real app in your browser</h2>
      <p>
        This is Loadout's own interface, running on sample skills, agents and projects. Click
        around, switch skills on, open the editor. Nothing you do there reaches your computer.
      </p>
      <div class="actions">
        <button class="button light" type="button" data-load-demo>Start the demo here</button>
        <a class="button quiet light" href={DEMO_PATH}>Open it full size</a>
      </div>
    </div>
    <div class="frame" data-demo-frame data-src={DEMO_PATH}>
      <p class="placeholder">The demo loads here when you start it.</p>
    </div>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLElement>("[data-demo-frame]");
  const start = document.querySelector<HTMLButtonElement>("[data-load-demo]");
  start?.addEventListener("click", () => {
    if (!frame || frame.querySelector("iframe")) return;
    const iframe = document.createElement("iframe");
    iframe.src = frame.dataset.src ?? "";
    iframe.title = "Loadout demo";
    frame.replaceChildren(iframe);
    start.hidden = true;
    iframe.focus();
  });
</script>

<style>
  .band {
    background: var(--band);
    color: var(--band-ink);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    max-width: 46rem;
  }

  .intro p {
    color: var(--band-slate);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .button.light {
    border-color: var(--band-ink);
    background: var(--band-ink);
    color: var(--band);
  }

  .button.light:hover {
    background: var(--mint);
    border-color: var(--mint);
  }

  .button.quiet.light {
    background: transparent;
    color: var(--band-ink);
  }

  .button.quiet.light:hover {
    background: color-mix(in srgb, var(--band-ink) 10%, transparent);
    border-color: var(--band-ink);
  }

  .band :focus-visible {
    outline-color: var(--mint);
  }

  .frame {
    display: grid;
    place-items: center;
    margin-top: clamp(2rem, 5vw, 3rem);
    aspect-ratio: 16 / 10;
    max-height: 80vh;
    width: 100%;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--band-ink) 18%, transparent);
    border-radius: 0.875rem;
    background: color-mix(in srgb, var(--band-ink) 4%, var(--band));
  }

  .placeholder {
    color: var(--band-slate);
    font-size: 0.9375rem;
  }

  .frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    background: #fff;
  }

  /* The app is laid out for a desktop window: on small screens, offer the full-size page only. */
  @media (max-width: 60rem) {
    .frame,
    [data-load-demo] {
      display: none;
    }
  }
</style>
