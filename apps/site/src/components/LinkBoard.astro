---
import { heroAgents } from "../lib/agents";
import { HERO_LINKED, HERO_SKILL, LIBRARY_DIR } from "../lib/site";
import PathText from "./PathText.astro";

const agents = heroAgents();
// The script below fills `{linked}` in as agents are switched; the page is built with the start.
const NONE_LINKED = "Not linked anywhere. Turn an agent on.";
const SOME_LINKED = `Linked into {linked} of these ${agents.length} agents. Edit it once and each of them reads the change.`;
---

<figure class="board" data-board data-none={NONE_LINKED} data-some={SOME_LINKED}>
  <div class="source">
    <strong>{HERO_SKILL}</strong>
    <PathText path={`${LIBRARY_DIR}/${HERO_SKILL}`} />
    <span class="where">in your library</span>
  </div>
  <ul class="targets" aria-label="Agents to link the skill into">
    {
      agents.map((agent, index) => (
        <li style={`--order: ${index}`}>
          <button type="button" aria-pressed={index < HERO_LINKED ? "true" : "false"}>
            <span class="name">{agent.displayName}</span>
            <span class="target-path">
              <PathText path={`~/${agent.skillsDir}/${HERO_SKILL}`} />
            </span>
            <span class="switch" aria-hidden="true" />
          </button>
        </li>
      ))
    }
  </ul>
  <figcaption aria-live="polite" data-status>
    {SOME_LINKED.replace("{linked}", String(HERO_LINKED))}
  </figcaption>
</figure>

<script>
  for (const board of document.querySelectorAll<HTMLElement>("[data-board]")) {
    const status = board.querySelector<HTMLElement>("[data-status]");
    const buttons = [...board.querySelectorAll<HTMLButtonElement>("button[aria-pressed]")];
    const describe = (linked: number): string =>
      linked === 0
        ? (board.dataset.none ?? "")
        : (board.dataset.some ?? "").replace("{linked}", String(linked));
    for (const button of buttons) {
      button.addEventListener("click", () => {
        button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"));
        const linked = buttons.filter((b) => b.getAttribute("aria-pressed") === "true").length;
        board.classList.toggle("empty", linked === 0);
        if (status) status.textContent = describe(linked);
      });
    }
    // One entrance: the links draw in once the page is ready.
    requestAnimationFrame(() => board.classList.add("ready"));
  }
</script>

<style>
  .board {
    --row: 3.5rem;
    --spine-gap: 3rem;
    --line: 2px;
    display: grid;
    grid-template-columns: minmax(0, 12.5rem) var(--spine-gap) minmax(0, 1fr);
    align-items: center;
    margin: 0;
  }

  .source {
    position: relative;
    display: grid;
    gap: 0.25rem;
    padding: 1.125rem 1.25rem;
    border: 1.5px solid var(--ink);
    border-radius: 0.875rem;
    background: var(--panel);
  }

  .source strong {
    font-size: 1.375rem;
    font-stretch: 80%;
    font-weight: 760;
    line-height: 1.1;
  }

  .source :global(.path),
  .targets :global(.path) {
    color: var(--slate);
  }

  .where {
    font-size: 0.875rem;
    color: var(--slate);
  }

  /* The source's line out to the spine. */
  .source::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: calc(var(--spine-gap) / 2);
    border-top: var(--line) solid var(--mint-ink);
  }

  .board.empty .source::after {
    border-top-style: dashed;
    border-top-color: var(--rule);
  }

  .targets {
    position: relative;
    grid-column: 3;
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The spine every branch hangs from, centre of the first row to centre of the last. */
  .targets::before {
    content: "";
    position: absolute;
    top: calc(var(--row) / 2);
    bottom: calc(var(--row) / 2);
    left: calc(var(--spine-gap) / -2);
    border-left: var(--line) solid var(--rule);
  }

  li {
    position: relative;
  }

  /* Each agent's branch off the spine. */
  li::before {
    content: "";
    position: absolute;
    top: 50%;
    left: calc(var(--spine-gap) / -2);
    width: calc(var(--spine-gap) / 2);
    border-top: var(--line) dashed var(--rule);
  }

  li:has([aria-pressed="true"])::before {
    border-top-style: solid;
    border-top-color: var(--mint-ink);
    transform-origin: left;
  }

  .board.ready li:has([aria-pressed="true"])::before {
    animation: draw 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--order) * 90ms + 150ms);
  }

  @keyframes draw {
    from {
      transform: scaleX(0);
    }
  }

  button {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "name switch"
      "path switch";
    align-items: center;
    column-gap: 1rem;
    width: 100%;
    min-height: var(--row);
    padding: 0.5rem 0.875rem;
    border: 1.5px solid var(--rule);
    border-radius: 0.75rem;
    background: transparent;
    color: var(--slate);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color 160ms,
      background-color 160ms,
      color 160ms;
  }

  button:hover {
    border-color: var(--slate);
  }

  button[aria-pressed="true"] {
    border-color: var(--mint-ink);
    background: var(--panel);
    color: var(--ink);
  }

  .name {
    grid-area: name;
    font-weight: 640;
    line-height: 1.25;
  }

  .target-path {
    grid-area: path;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .switch {
    grid-area: switch;
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--rule);
    transition: background-color 160ms;
  }

  .switch::after {
    content: "";
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--panel);
    transition: transform 160ms;
  }

  [aria-pressed="true"] .switch {
    background: var(--mint-ink);
  }

  [aria-pressed="true"] .switch::after {
    transform: translateX(1rem);
  }

  figcaption {
    grid-column: 1 / -1;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    color: var(--slate);
  }

  /* Narrow screens: the library on top, agents hanging below it from a spine on the left. */
  @media (max-width: 44rem) {
    .board {
      --spine-gap: 2rem;
      grid-template-columns: minmax(0, 1fr);
    }

    .source::after {
      top: 100%;
      left: calc(var(--spine-gap) / 2);
      width: 0;
      height: 1.25rem;
      border-top: 0;
      border-left: var(--line) solid var(--mint-ink);
    }

    .board.empty .source::after {
      border-left-style: dashed;
      border-left-color: var(--rule);
    }

    .targets {
      grid-column: 1;
      margin-top: 1.25rem;
      padding-left: var(--spine-gap);
    }

    .targets::before {
      top: 0;
      left: calc(var(--spine-gap) / 2);
    }

    li::before {
      left: calc(var(--spine-gap) / -2);
    }
  }
</style>
