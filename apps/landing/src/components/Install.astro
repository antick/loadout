---
import { loadDownloads } from "../lib/downloads";
import { INSTALL_GUIDE_URL, LATEST_RELEASE_URL, RELEASES_URL } from "@loadout/shared";
import { APP_VERSION } from "../lib/site";
import DownloadButton from "./DownloadButton.astro";

const downloads = await loadDownloads();
---

<section class="wrap section install" id="install" aria-labelledby="install-title">
  <div class="download-panel">
    <div>
      <h2 id="install-title">Give every agent your best skills.</h2>
      <p>Tools are better with your context.</p>
    </div>
    <div class="download-action">
      <DownloadButton href={LATEST_RELEASE_URL} />
      <p>Available for macOS, Windows &amp; Linux</p>
    </div>
  </div>
  <details class="install-options">
    <summary>Choose your platform &amp; installation help</summary>
    <div class="install-body">
      <p>Version {downloads?.version ?? APP_VERSION}. Pick the installer for your computer.</p>
      {downloads && <dl class="downloads">
        {downloads.groups.map((group) => <div>
          <dt>{group.system}</dt>
          <dd>{group.downloads.map((download) => <a class="button button-outline" href={download.url}>
            {download.label} <span class="kind">{download.kind}</span>
          </a>)}</dd>
        </div>)}
      </dl>}
      <p>
        The builds aren't signed with an Apple or Microsoft certificate yet, so your system may
        ask for an extra step on first launch. <a href={INSTALL_GUIDE_URL}>Follow the install guide</a>.
        After that, Loadout can check for updates and install them with one restart.
      </p>
      <a class="release-link" href={RELEASES_URL}>Browse all releases <span aria-hidden="true">↗</span></a>
    </div>
  </details>
</section>

<style>
  .download-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--on-dark);
  }
  h2 {
    max-width: 40rem;
    font-size: clamp(1.75rem, 3.1vw, 2.625rem);
  }
  .download-panel p {
    margin-top: 0.625rem;
    color: var(--muted-on-dark);
  }
  .download-action {
    flex-shrink: 0;
    text-align: center;
  }
  .download-action p {
    font-size: 0.6875rem;
  }
  .download-panel :global(:focus-visible) {
    outline-color: var(--on-dark);
  }
  .install-options {
    margin-top: 1rem;
  }
  summary {
    width: fit-content;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .install-body {
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .install-body p {
    max-width: 65ch;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .downloads {
    display: grid;
    gap: 1.25rem;
    margin-block: 1.5rem;
  }
  .downloads > div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    align-items: baseline;
  }
  dt {
    font-weight: 600;
  }
  dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
  }
  .kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .release-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
  @media (max-width: 48rem) {
    .download-panel {
      flex-direction: column;
      align-items: start;
    }
    .downloads > div {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
