---
import { AGENT_COUNT, assistantAgents, codingAgents } from "../lib/agents";

const groups = [
  { title: "Coding agents", agents: codingAgents() },
  { title: "Assistants", agents: assistantAgents() },
].filter((group) => group.agents.length > 0);
---

<section class="wrap section" id="agents" aria-labelledby="agents-title">
  <span class="chapter-label">Compatible equipment</span>
  <h2 id="agents-title">Works with {AGENT_COUNT} agents</h2>
  <p class="lede">
    Loadout finds the agents installed on your computer and knows where each one looks for skills.
    Anything missing? Add it as a custom agent with its own folder.
  </p>
  {
    groups.map((group) => (
      <div class="group">
        <h3>{group.title}</h3>
        <ul>
          {group.agents.map((agent) => (
            <li>
              <span class="name">{agent.displayName}</span>
              <code class="path">~/{agent.skillsDir}</code>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .lede {
    margin-top: 1rem;
  }

  .group {
    margin-top: 2.5rem;
  }

  .group h3 {
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--rule-strong);
    font-size: 1.125rem;
  }

  ul {
    columns: 3 16rem;
    column-gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--rule);
    break-inside: avoid;
    font-size: 0.9375rem;
  }

  .name {
    font-weight: 500;
  }

  .path {
    overflow: hidden;
    color: var(--slate);
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
