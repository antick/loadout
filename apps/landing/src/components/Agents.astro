---
import { AGENT_COUNT, agentsInOrder, FEATURED_AGENTS } from "../lib/agents";
---

<section class="wrap agents" id="agents" aria-labelledby="agents-title">
  <h2 id="agents-title">One library. {AGENT_COUNT} agents.</h2>
  <ul class="featured" aria-label="Featured supported agents">
    {FEATURED_AGENTS.map((agent) => <li>{agent.displayName}</li>)}
  </ul>
  <details>
    <summary>+{AGENT_COUNT - FEATURED_AGENTS.length} more <span class="visually-hidden">: view all supported agents</span></summary>
    <div class="directory">
      <p>Loadout finds your installed agents automatically. You can also add a custom agent.</p>
      <ul class="all-agents">
        {agentsInOrder().map((agent) => <li>{agent.displayName}</li>)}
      </ul>
    </div>
  </details>
</section>

<style>
  .agents {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 0.75rem;
    margin-top: 3rem;
  }
  h2 {
    grid-column: 1 / -1;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-align: center;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .featured {
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .featured li {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  summary {
    width: fit-content;
    margin-inline: auto;
    font-size: 0.875rem;
    font-weight: 400;
  }
  .directory {
    margin-top: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .directory p {
    color: var(--muted);
  }
  .all-agents {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }
  @media (max-width: 48rem) {
    .featured {
      justify-content: center;
    }
    .all-agents {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 23rem) {
    .all-agents {
      grid-template-columns: 1fr;
    }
  }
</style>
