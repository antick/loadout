---
import { DOWNLOADS_URL, INSTALL_GUIDE } from "../lib/site";

const platforms = ["macOS", "Windows", "Linux"];
const platformList = `${platforms.slice(0, -1).join(", ")} and ${platforms.at(-1)}`;
---

<section class="wrap section download" id="download" aria-labelledby="download-title">
  <h2 id="download-title">Get Loadout</h2>
  {
    DOWNLOADS_URL ? (
      <>
        <p class="lede">A desktop app for {platformList}.</p>
        <div class="actions">
          <a class="button" href={DOWNLOADS_URL}>
            Download the latest release
          </a>
        </div>
        <p class="note">
          The builds are not signed with an Apple or Microsoft certificate yet, so the first launch
          needs one extra click. <a href={INSTALL_GUIDE}>The install steps</a> say which file to pick
          and what to click. After that, Loadout updates itself.
        </p>
      </>
    ) : (
      <p class="lede">Installers for {platformList} are not published yet.</p>
    )
  }
</section>

<style>
  .download {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .note {
    margin-top: 1.25rem;
    max-width: 38rem;
    color: var(--slate);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
