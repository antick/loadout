---
interface Guarantee {
  title: string;
  body: string;
}

// The same promises the app's help makes, in fewer words.
const guarantees: Guarantee[] = [
  {
    title: "Agent folders",
    body: "Loadout never overwrites or deletes anything in an agent's folder that it did not put there. If something is in the way, it tells you the exact path and stops.",
  },
  {
    title: "Your edits",
    body: "A save never overwrites a change made on disk after you opened the file: you see both and choose. Updates hold back skills you edited until you say otherwise.",
  },
  {
    title: "Deleting files",
    body: "An update that would delete files lists them and waits for your approval. Automatic updates never delete anything.",
  },
  {
    title: "Your data",
    body: "Everything lives in ~/.loadout on your computer. The backup goes only to a Git remote you choose, and a GitHub token is kept in the system keychain.",
  },
];
---

<section class="wrap section" id="safety" aria-labelledby="safety-title">
  <span class="chapter-label">Safety</span>
  <h2 id="safety-title">It only touches what it put there</h2>
  <ul>
    {
      guarantees.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 1.25rem 1.5rem 1.375rem;
    border: 1.5px solid var(--rule-strong);
    border-left-width: 6px;
    border-left-color: var(--signal);
    border-radius: 4px;
    background: var(--panel);
  }

  h3 {
    font-size: 1.1875rem;
  }

  p {
    margin-top: 0.5rem;
    color: var(--slate);
  }

  @media (max-width: 48rem) {
    ul {
      grid-template-columns: 1fr;
    }
  }
</style>
