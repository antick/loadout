---
import { GUARANTEES } from "../lib/content";
import Icon from "./Icon.astro";
---

<section class="wrap section safety" id="safety" aria-labelledby="safety-title">
  <h2 id="safety-title">Your skills stay yours.</h2>
  <ul>{GUARANTEES.map((item) => <li>
    <Icon name={item.icon} />
    <div><h3>{item.title}</h3><p>{item.body}</p></div>
  </li>)}</ul>
</section>

<style>
  .safety {
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  h2 {
    font-size: 1.5rem;
    letter-spacing: -0.045em;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    gap: 1rem;
  }
  li + li {
    padding-left: 2rem;
    border-left: 1px solid var(--rule);
  }
  li :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }
  h3 {
    font-size: 0.9375rem;
  }
  p {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  @media (max-width: 48rem) {
    ul {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    li + li {
      padding: 1.5rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
