---
import { SOURCE_URL } from "@loadout/shared";
import { LIBRARY_FIGURE } from "../lib/site";
import DownloadButton from "./DownloadButton.astro";
import Icon from "./Icon.astro";
---

<section class="wrap hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow">Your skills. Every agent.</p>
    <h1 id="hero-title">One library.<br /><span>Every agent.</span></h1>
    <p class="lede">
      Keep your AI skills in one place. Use them across Claude Code, Codex, Cursor, and more.
    </p>
    <div class="actions">
      <DownloadButton />
      <a class="button button-outline" href={SOURCE_URL}>
        <Icon name="code" /> View on GitHub
      </a>
    </div>
    <p class="platforms">Free and open source <span aria-hidden="true">·</span> macOS &amp; Linux</p>
  </div>
  <figure class="product">
    <div class="window-bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <span class="window-title">Loadout / Library</span>
    </div>
    <img src={LIBRARY_FIGURE.src} alt={LIBRARY_FIGURE.alt}
      width={LIBRARY_FIGURE.width} height={LIBRARY_FIGURE.height}
      loading="eager" fetchpriority="high" />
    <figcaption class="visually-hidden">
      The Loadout library: browse skills and see which agents use each one.
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 4vw, 3rem);
  }
  .hero-copy {
    text-align: center;
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.065em;
  }
  h1 span {
    color: var(--accent);
  }
  .lede {
    max-width: 50rem;
    margin: 1.625rem auto 0;
  }
  .actions {
    justify-content: center;
    margin-top: 1.5rem;
  }
  .platforms {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .product {
    max-width: 70rem;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    overflow: hidden;
    border: 1px solid var(--frame);
    border-radius: var(--radius);
    background: var(--window);
    box-shadow:
      0 8px 60px -12px var(--glow),
      0 20px 50px -35px var(--shadow);
  }
  .window-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding-inline: 0.875rem;
    border-bottom: 1px solid var(--frame);
  }
  .window-bar > span:not(.window-title) {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--window-dot);
  }
  .window-title {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.625rem;
  }
  .product img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 40rem) {
    .lede {
      max-width: 23rem;
    }
    .platforms {
      max-width: 17rem;
      margin-inline: auto;
    }
  }

  @media (max-width: 23rem) {
    h1 {
      font-size: 3rem;
    }
  }
</style>
