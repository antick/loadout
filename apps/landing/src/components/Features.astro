---
import { EXTRA_FEATURES, FEATURES } from "../lib/content";
import FeaturePreview from "./FeaturePreview.astro";
---

<section class="wrap section features" id="what-it-does" aria-labelledby="features-title">
  <div class="intro">
    <h2 id="features-title">Less setup.<br /><span>More building.</span></h2>
    <p class="lede">Install once, choose your agents, and get back to work.</p>
  </div>
  {FEATURES.map((feature) => <article class="feature">
    <FeaturePreview kind={feature.key} />
    <h3>{feature.title}</h3>
    <p>{feature.body}</p>
  </article>)}
  <details class="extras">
    <summary>And a few more things you'll love</summary>
    <dl>{EXTRA_FEATURES.map((feature) => <div><dt>{feature.title}</dt><dd>{feature.body}</dd></div>)}</dl>
  </details>
</section>

<style>
  .features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  .intro {
    align-self: center;
    padding-right: 0.5rem;
  }
  h2 {
    font-size: clamp(2rem, 3vw, 2.75rem);
  }
  h2 span {
    color: var(--accent);
  }
  .intro p {
    margin-top: 1rem;
    font-size: 1rem;
  }
  .feature {
    min-width: 0;
    padding: 1.375rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: linear-gradient(var(--paper), var(--panel));
  }
  .feature p {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .extras {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
  }
  summary {
    width: fit-content;
    color: var(--muted);
    font-size: 0.875rem;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 1.5rem 0 0;
  }
  dt {
    font-weight: 650;
  }
  dd {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }
  @media (max-width: 64rem) {
    .features {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .intro {
      grid-column: 1 / -1;
      padding-bottom: 1rem;
    }
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 42rem) {
    .features,
    dl {
      grid-template-columns: 1fr;
    }
    .feature {
      padding: 1.5rem;
    }
    .feature :global(.preview) {
      max-width: 20rem;
      margin-inline: auto;
    }
  }
</style>
