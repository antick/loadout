---
import { SOURCE_URL } from "@loadout/shared";
import Brand from "./Brand.astro";
import DownloadButton from "./DownloadButton.astro";
---

<header class="wrap header">
  <Brand />
  <nav aria-label="Main navigation">
    <a class="section-link" href="#what-it-does">Features</a>
    <a class="section-link" href="#agents">Agents</a>
    <a class="source-link" href={SOURCE_URL}>GitHub</a>
    <DownloadButton compact />
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.25rem);
    font-size: 0.875rem;
    font-weight: 550;
  }
  nav > a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }
  @media (max-width: 40rem) {
    nav > .section-link {
      display: none;
    }
  }
  @media (max-width: 23rem) {
    nav > .source-link {
      display: none;
    }
  }
</style>
