---
import { APP_NAME, INSTALL_GUIDE_URL, RELEASES_URL, SOURCE_URL } from "@loadout/shared";
import Agents from "../components/Agents.astro";
import Brand from "../components/Brand.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Install from "../components/Install.astro";
import Features from "../components/Features.astro";
import Safety from "../components/Safety.astro";
import Base from "../layouts/Base.astro";
import { AGENT_COUNT } from "../lib/agents";
import { PARENT_NAME, PARENT_URL } from "../lib/site";
---

<Base title={`${APP_NAME}: one skill library for every coding agent`}
  description={`Keep your AI skills in one place and use them across ${AGENT_COUNT} agents, including Claude Code, Codex and Cursor. Free and open source for macOS, Windows and Linux.`}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Agents />
    <Features />
    <Safety />
    <Install />
  </main>
  <footer class="wrap footer">
    <Brand />
    <p>A <a href={PARENT_URL}>{PARENT_NAME}</a> project</p>
    <nav aria-label="Footer navigation">
      <a href={SOURCE_URL}>GitHub</a>
      <a href={RELEASES_URL}>Releases</a>
      <a href={INSTALL_GUIDE_URL}>Install guide</a>
    </nav>
  </footer>
</Base>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    padding-block: 2.5rem;
  }
  .footer p,
  nav {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  nav a,
  .footer p a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }
  @media (max-width: 40rem) {
    .footer {
      flex-direction: column;
      align-items: start;
      gap: 0.5rem;
    }
  }
</style>
