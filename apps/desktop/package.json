{
  "name": "@loadout/desktop",
  "version": "0.4.2",
  "private": true,
  "description": "Loadout desktop app",
  "license": "GPL-3.0-only",
  "author": "Pankaj",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:browser": "vite --config e2e/vite.config.ts",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:ui": "playwright test",
    "package": "electron-builder --config electron-builder.yml",
    "icons": "swift scripts/make-icons.swift",
    "postinstall": "install-electron && node scripts/name-dev-electron.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@loadout/cli": "workspace:*",
    "@loadout/core": "workspace:*",
    "@loadout/shared": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/router-plugin": "1.168.46",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "diff": "9.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "electron-vite": "6.0.0",
    "i18next": "26.4.6",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
