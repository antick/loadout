{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": false,
  "semi": true,
  "trailingComma": "all",
  "ignorePatterns": [
    ".agents/skills/openspec-*/**",
    ".claude/skills/openspec-*/**",
    ".cursor/skills/openspec-*/**",
    ".dsh/skills/openspec-*/**",
    ".claude/worktrees/**",
    "**/routeTree.gen.ts",
    "**/dist/**",
    "**/out/**",
    "apps/desktop/release/**",
    "pnpm-lock.yaml"
  ]
}
