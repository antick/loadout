{
  "name": "skillboard",
  "version": "0.1.0",
  "private": true,
  "description": "One desktop app to manage AI agent skills across every coding tool.",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "cli": "pnpm --filter @skillboard/cli run start --",
    "package": "turbo run package"
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
