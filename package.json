{
  "name": "loadout",
  "version": "0.1.0",
  "private": true,
  "description": "One desktop app to manage AI agent skills across every coding tool.",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "turbo run dev --filter=@loadout/desktop --continue=dependencies-successful",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/test.mjs",
    "lint": "oxlint --deny-warnings && node scripts/check-dashes.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "specs": "openspec list",
    "specs:check": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "cli": "pnpm --filter @loadout/cli run start --",
    "package": "turbo run package"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@12.4.2"
}
