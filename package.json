{
  "name": "skillboard",
  "version": "0.1.0",
  "private": true,
  "description": "One desktop app to manage AI agent skills across every coding tool.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "cli": "bun run --filter @skillboard/cli start --"
  },
  "devDependencies": {
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "electron",
    "esbuild"
  ]
}
