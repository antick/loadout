{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@loadout/landing", "run", "preview", "--port", "4399"],
      "port": 4399
    },
    {
      "name": "desktop-browser",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@loadout/desktop", "run", "dev:browser"],
      "port": 5199,
      "env": {
        "LOADOUT_RENDERER_PORT": "5199"
      }
    }
  ]
}
